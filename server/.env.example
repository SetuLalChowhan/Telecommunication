# ==============================================================================
# Application Configuration
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/nest_auth_db?schema=public"
# Maximum database pool connections (Recommended: 10-20 for standard DBs, 5-10 for serverless/Neon)
DB_POOL_MAX=10

# ==============================================================================
# Better Auth Configuration
# ==============================================================================
# A strong random secret key (minimum 32 characters). REQUIRED in production.
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"

# Public URL of the patient/doctor web app. REQUIRED in production (https).
CLIENT_URL="http://localhost:3000"

# Dedicated key used to encrypt stored OAuth tokens (AES-256-GCM).
# Minimum 32 characters. REQUIRED in production. Rotating it invalidates
# encrypted tokens, so keep it separate from BETTER_AUTH_SECRET.
TOKEN_ENCRYPTION_KEY="your-dedicated-encryption-key-at-least-32-chars"

# Number of trusted reverse proxies in front of the app (omit if directly
# exposed). Required for correct client IPs behind a load balancer.
# TRUST_PROXY=1

# Comma-separated list of allowed frontend origins for CORS and Redirects.
# In production every entry must be an https origin and "*" is rejected.
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ==============================================================================
# Cloudinary (avatars & medical reports) — all three required together
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ==============================================================================
# Google OAuth & Calendar API Configuration
# ==============================================================================
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# ==============================================================================
# Super Admin Initial Seeding
# ==============================================================================


# ==============================================================================
# SMTP Email Configuration (Nodemailer)
# ==============================================================================
EMAIL_HOST="smtp.gmail.com"
# Port 587 for STARTTLS (EMAIL_SECURE=false) or 465 for SSL (EMAIL_SECURE=true)
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER="your-email@example.com"
# For Gmail, use an 16-character App Password (not your normal Gmail password)
EMAIL_PASS="your-email-app-password"
