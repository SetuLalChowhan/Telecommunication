// -------------------------------------------------------------
// Website CMS & Public Sections Content Management
// -------------------------------------------------------------
model WebsiteSection {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "home_hero", "home_how_it_works", "home_advice", "home_testimonials", "about_hero", "about_stats", "about_leadership"
  title       String
  subtitle    String?
  badge       String?
  content     Json?    // Structured cards, steps, points, metrics, team array
  imageUrl    String?
  ctaText     String?
  ctaLink     String?
  metadata    Json?    // Extra layout configs or SEO tags
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([isActive])
}

// -------------------------------------------------------------
// Healthcare Articles & Blogs CMS
// -------------------------------------------------------------
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  subtitle      String?
  excerpt       String?   @db.Text
  content       Json      // Structured blocks (paragraphs, headings, lists, quotes, callouts)
  featuredImage String
  imageCaption  String?
  category      String    @default("General Health")
  tags          String[]  @default([])
  readTime      String    @default("5 min read")
  published     Boolean   @default(false)
  publishedAt   DateTime?
  featured      Boolean   @default(false)
  viewsCount    Int       @default(0)
  
  // Medical Author Details
  authorName    String
  authorRole    String
  authorAvatar  String
  authorBio     String?
  
  // Medical Reviewer Details
  reviewerName  String?
  reviewerTitle String?
  reviewerAvatar String?
  reviewerDate  String?
  
  keyTakeaways  String[]  @default([])
  faqs          Json?     // [{ question: string, answer: string }]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([category])
  @@index([featured])
}
